{
  "id": "session-link-notice",
  "name": "Session Link Notice",
  "description": "Channel-only session links on first request or after inactivity. No tools or prompt contributions.",
  "version": "0.1.1",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "label": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120,
        "default": "Open in OpenClaw"
      },
      "onSessionStart": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": true
          }
        }
      },
      "afterInactivity": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": false
          },
          "minutes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 525600,
            "default": 60
          }
        }
      },
      "allowedAgentIds": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "uniqueItems": true,
        "description": "Agent IDs allowed to send notices. Omit for all agents; an empty list disables notices."
      }
    }
  },
  "uiHints": {
    "label": {
      "label": "Link text"
    },
    "onSessionStart.enabled": {
      "label": "Notify on first request",
      "help": "Enabled by default."
    },
    "afterInactivity.enabled": {
      "label": "Notify after inactivity",
      "help": "Independent of first-request notifications; disabled by default."
    },
    "afterInactivity.minutes": {
      "label": "Inactivity threshold (minutes)"
    },
    "allowedAgentIds": {
      "label": "Allowed agent IDs",
      "help": "For example [\"main\"]. Omit for all agents; [] disables notices."
    }
  },
  "activation": {
    "onStartup": true
  }
}
